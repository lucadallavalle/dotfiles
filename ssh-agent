# The agent is the ssh-agent.socket systemd user unit, and SSH_AUTH_SOCK comes
# from ~/.config/environment.d/. This only covers shells that didn't inherit
# it (SSH logins, old tmux panes); a forwarded agent is left alone.
if [[ ! -S "$SSH_AUTH_SOCK" ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi
